root = true

[*]
end_of_line = lf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

# The repo is genuinely mixed, not inconsistent by accident:
# root-level app files use tabs, chrome-extension/ and test/ use 2 spaces.
# Match whichever this file already uses -- do not apply a blanket rule here.
[{app.js,styles.css,serve.js,index.html}]
indent_style = tab

[{chrome-extension/**,test/**,tracker-core.js,scripts/**}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
