{
  "manifest_version": 3,
  "name": "Too Many Tokens Provider Sync",
  "version": "0.5.0",
  "description": "Discover every quota on selected provider tabs and sync it to the Too Many Tokens dashboard.",
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://*.claude.ai/*",
    "https://*.openai.com/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*"
  ],
  "action": {
    "default_title": "Open Too Many Tokens"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5074/*",
        "http://127.0.0.1:5074/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
